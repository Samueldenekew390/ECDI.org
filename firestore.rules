rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Applications Collection Security Rules
    match /applications/{applicationId} {
      // Public can submit an application (create)
      allow create: if request.resource.data.keys().hasAll([
        'applicationId', 'fullName', 'email', 'phone', 'academicCategory', 
        'specificDegree', 'educationLevel', 'university', 'cvStoragePath', 
        'paymentStatus', 'applicationStatus'
      ]) && request.resource.data.paymentStatus == 'Payment Pending';

      // Applicants can query/get their own application status by ID
      allow get: if true;

      // Applicants can update payment proof on their own pending application
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentScreenshotStoragePath', 'paymentScreenshotOriginalName', 
        'paymentStatus', 'applicationStatus', 'paymentSubmittedAt', 'updatedAt', 'statusHistory'
      ]) || isAdmin();

      // Only authenticated admins can list, delete, or freely manage all applications
      allow list, delete: if isAdmin();
    }

    // Payment Methods Collection Security Rules
    match /paymentMethods/{paymentMethodId} {
      // Public can read active payment methods
      allow read: if resource.data.isActive == true || isAdmin();

      // Only authenticated admins can create, edit, or delete payment methods
      allow write: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
